<Page x:Class="StudentView.LoginView.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:StudentView.LoginView"
      Background="#DCDCDC">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480">
            <!-- 흰 카드 + 학생 로그인 타이틀 -->
            <local:StudentLogin Margin="0,0,0,16"/>
            <!-- 학번 라벨 + 입력창 -->
            <local:StudentNumber x:Name="StudentNumberInput" Margin="0,0,0,12"/>
            <!-- 이름 라벨 + 입력창 -->
            <local:StudentInputName x:Name="StudentNameInput" Margin="0,0,0,12"/>
            <!-- 로그인 버튼 -->
            <local:LoginButton x:Name="LoginBtn"/>
        </StackPanel>
    </Grid>
</Page>