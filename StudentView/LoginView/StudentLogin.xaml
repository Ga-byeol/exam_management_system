<UserControl x:Class="StudentView.LoginView.StudentLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="White"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="480"
            Padding="40,36">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="40" ShadowDepth="8"/>
        </Border.Effect>

        <StackPanel>
           
            <!-- 학생 로그인 타이틀 -->
            <TextBlock Text="학생 로그인"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

        </StackPanel>
    </Border>
</UserControl>