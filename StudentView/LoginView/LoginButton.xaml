<UserControl x:Class="StudentView.LoginView.LoginButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="Login_Button"
            Height="52"
            BorderThickness="0"
            Cursor="Hand">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder"
                        Background="#16A34A"
                        CornerRadius="12">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonBorder" Property="Background" Value="#15803D"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonBorder" Property="Background" Value="#166534"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="→ " FontSize="16" Foreground="White"/>
            <TextBlock Text="로그인" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </StackPanel>
    </Button>
</UserControl>