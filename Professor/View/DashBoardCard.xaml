<UserControl x:Class="Exam.View.DashBoardCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <!-- 배경을 투명하게 해서 여백처럼 보이는 공간 완전히 제거 -->

    <!-- 바깥쪽 여백 0 -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. 총 학생 -->
        <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" 
                             UniformCornerRadius="16"
                             materialDesign:ElevationAssist.Elevation="Dp4"
                             Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,20">
                <TextBlock Text="총 학생" Foreground="#64748B" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Text="20" Foreground="#1E293B" FontSize="26" FontWeight="Bold" Margin="10,8,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 2. 접속 -->
        <materialDesign:Card Grid.Column="1" Margin="0,0,10,0" 
                             UniformCornerRadius="16"
                             materialDesign:ElevationAssist.Elevation="Dp4"
                             Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5">
            <StackPanel Margin="24,20">
                <TextBlock Text="접속" Foreground="#64748B" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="18" Foreground="#2563EB" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 3. 진행 중 -->
        <materialDesign:Card Grid.Column="2" Margin="0,0,10,0" 
                             UniformCornerRadius="16"
                             materialDesign:ElevationAssist.Elevation="Dp4"
                             Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5">
            <StackPanel Margin="24,20">
                <TextBlock Text="진행 중" Foreground="#64748B" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="0" Foreground="#059669" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 4. 부정행위 -->
        <materialDesign:Card Grid.Column="3" Margin="0,0,0,0" 
                             UniformCornerRadius="16"
                             materialDesign:ElevationAssist.Elevation="Dp4"
                             Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5">
            <StackPanel Margin="24,20">
                <TextBlock Text="부정행위" Foreground="#64748B" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="0" Foreground="#DC2626" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" />
            </StackPanel>
        </materialDesign:Card>

    </Grid>
</UserControl>