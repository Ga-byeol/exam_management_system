<UserControl x:Class="Exam.View.StartExamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Exam.View"
        mc:Ignorable="d">
    <Border Width="280" Height="360" Background="White" BorderBrush="#5C6BC0" BorderThickness="1.5" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 상단: 숫자와 뱃지 -->
                <RowDefinition Height="Auto"/>
                <!-- 아이콘 -->
                <RowDefinition Height="Auto"/>
                <!-- 제목과 설명 -->
                <RowDefinition Height="*"/>
                <!-- 빈 공간 밀어내기 -->
                <RowDefinition Height="Auto"/>
                <!-- 하단: 경고창과 버튼 -->
            </Grid.RowDefinitions>

            <!-- 1. 상단: 원형 숫자 & 상태 뱃지 -->
            <DockPanel Grid.Row="0">
                <!-- 우측: '진행 중' 뱃지 -->
                <Border DockPanel.Dock="Right" Background="#E8EAF6" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                    <TextBlock Text="진행 중" Foreground="#5C6BC0" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- 좌측: 숫자 '1' -->
                <Border Width="32" Height="32" CornerRadius="16" Background="#5C6BC0" HorizontalAlignment="Left">
                    <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>

            <!-- 2. 아이콘 영역 -->
            <Border Grid.Row="1" Width="44" Height="44" CornerRadius="8" Background="#E8EAF6" HorizontalAlignment="Left" Margin="0,24,0,20">
                <materialDesign:PackIcon Kind="PlayOutline" Foreground="#5C6BC0" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 3. 제목 & 설명 텍스트 -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="시험 시작" FontSize="18" FontWeight="Bold" Foreground="#312E81" Margin="0,0,0,8"/>
                <TextBlock Text="학생 PC 압축 해제 후 시험을 시작합니다." Foreground="#6B7280" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>

            <!-- 4. 하단 고정 영역: 경고 박스 & 버튼 -->
            <StackPanel Grid.Row="4">

                <!-- 주황색 경고 박스 -->
                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertOutline" Foreground="#D97706" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="파일 배포 먼저 완료 필요" Foreground="#D97706" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 시험 시작 버튼 -->
                <Button Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#111827" Height="46" 
                    materialDesign:ButtonAssist.CornerRadius="8" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <TextBlock Text="시험 시작" FontSize="16" FontWeight="SemiBold"/>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
