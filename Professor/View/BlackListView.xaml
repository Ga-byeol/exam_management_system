<UserControl x:Class="Exam.View.BlackListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="White"
            CornerRadius="12"
            Padding="20"
            Margin="0,0,0,12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05"
                              BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel>

            <!-- ① 헤더 영역 -->
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,4">

                    <!-- 아이콘 -->
                    <TextBlock Text="🚫"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- 제목 텍스트 -->
                    <TextBlock Text="차단 프로그램 (블랙리스트)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#7D1A1A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 설명 -->
                <TextBlock Text="시험 중 학생 PC에서 실행 시 강제 종료되며 즉시 알림이 발송됩니다"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 구분선 -->
            <Separator Margin="0,0,0,12" Background="#F0F0F0"/>

            <!-- ② 태그 목록 -->
            <WrapPanel x:Name="BlacklistTagPanel"
                       Margin="0,0,0,12">

                <!-- Chrome 태그 -->
                <Border Background="#FFF0F0"
                        CornerRadius="20"
                        Padding="10,6"
                        Margin="0,0,6,6"
                        BorderBrush="#FFCCCC"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="Chrome"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"/>
                        <Button Content="×"
                                FontSize="14"
                                Foreground="#C0392B"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="6,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Firefox 태그 -->
                <Border Background="#FFF0F0"
                        CornerRadius="20"
                        Padding="10,6"
                        Margin="0,0,6,6"
                        BorderBrush="#FFCCCC"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="Firefox"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"/>
                        <Button Content="×"
                                FontSize="14"
                                Foreground="#C0392B"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="6,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- KakaoTalk 태그 -->
                <Border Background="#FFF0F0"
                        CornerRadius="20"
                        Padding="10,6"
                        Margin="0,0,6,6"
                        BorderBrush="#FFCCCC"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="KakaoTalk"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"/>
                        <Button Content="×"
                                FontSize="14"
                                Foreground="#C0392B"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="6,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ③ 입력창 + 추가 버튼 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 입력창 -->
                <Border Grid.Column="0"
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0">
                    <TextBox x:Name="BlacklistInput"
                             FontSize="13"
                             Foreground="#333333"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,10"
                             VerticalAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="PlaceholderBrush"
                                                 AlignmentX="Left"
                                                 AlignmentY="Center"
                                                 Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="프로그램 이름 입력 후 Enter"
                                                       FontSize="13"
                                                       Foreground="#AAAAAA"
                                                       Margin="12,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background"
                                                Value="{StaticResource PlaceholderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- 추가 버튼 -->
                <Button Grid.Column="1"
                Content="+ 추가"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C0392B"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- ControlTemplate 안에 트리거 넣기 -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#A93226"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#922B21"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

        </StackPanel>
    </Border>
</UserControl>