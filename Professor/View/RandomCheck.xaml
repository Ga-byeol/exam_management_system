<UserControl x:Class="Exam.View.RandomCheck"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"     
        xmlns:local="clr-namespace:Exam.View"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 카드 -->
            <RowDefinition Height="*"/>
            <!-- 하단 카드 (남은 공간 다 차지) -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. 상단 카드: 출석 체크 전송 패널 -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="2" CornerRadius="12" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <!-- 타이틀 영역 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="BellOutline" Foreground="#F59E0B" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="돌발 출석 체크" FontSize="20" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 설명 텍스트 -->
                <TextBlock Text="학생 PC에 팝업을 전송하여 즉각 응답을 수집합니다." FontSize="14" Foreground="#9CA3AF" Margin="0,0,0,20"/>

                <!-- 주황색 전송 버튼 -->
                <Button Height="54" Background="#F59E0B" BorderThickness="0" Foreground="White" FontSize="18" FontWeight="Bold"
                        materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BellRingOutline" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="돌발 출석 체크 전송" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
