<UserControl x:Class="Exam.View.FileSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exam.View"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 아까의 1번 카드 내용만 쏙 빼옴 -->
    <Border Background="White" BorderBrush="#5C6BC0" BorderThickness="1.5" CornerRadius="12" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 헤더 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <DockPanel Margin="0,0,0,16">
                    <!-- 보라색 '진행 중' 뱃지 -->
                    <Border DockPanel.Dock="Right" Background="#E8EAF6" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                        <TextBlock Text="진행 중" Foreground="#5C6BC0" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <!-- 보라색 숫자 1 -->
                    <Border Width="32" Height="32" CornerRadius="16" Background="#5C6BC0" HorizontalAlignment="Left">
                        <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
                <!-- 진한 남색 제목 -->
                <TextBlock Text="파일 준비 및 암호화" FontSize="24" FontWeight="Bold" Foreground="#312E81" Margin="0,0,0,8"/>
                <TextBlock Text="배포할 원본 폴더를 선택하면, 자동으로 암호화 및 압축을 진행합니다." Foreground="#6B7280" FontSize="15" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 2. 파일 선택 -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="원본 대상 폴더" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="C:\ExamData\Midterm_Files" FontSize="15" Padding="10" 
                             BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" VerticalContentAlignment="Center"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="8"/>
                    <Button Grid.Column="1" Margin="10,0,0,0" Width="46" Height="46" Background="White" BorderThickness="1" BorderBrush="#D1D5DB"
                            Foreground="#4B5563" materialDesign:ButtonAssist.CornerRadius="8" Style="{StaticResource MaterialDesignOutlinedButton}">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="24" Height="24"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 3. 진행 상태 -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <!-- 진행률 텍스트 보라색 -->
                        <TextBlock DockPanel.Dock="Right" Text="65%" FontWeight="Bold" Foreground="#5C6BC0" FontSize="16"/>
                        <TextBlock Text="압축 및 암호화 진행 중..." FontWeight="SemiBold" Foreground="#4B5563" FontSize="14"/>
                    </DockPanel>
                    <!-- 프로그레스 바 보라색 -->
                    <ProgressBar Value="65" Height="10" Foreground="#5C6BC0" Background="#E2E8F0" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                    <TextBlock Text="현재 파일: /images/diagram_01.png (3.2MB)" Foreground="#94A3B8" FontSize="13" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. 하단 버튼 -->
            <Button Grid.Row="4" Content="압축 및 암호화 시작" Height="54" FontSize="18" FontWeight="SemiBold" 
                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#111827"
                    materialDesign:ButtonAssist.CornerRadius="8" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </Grid>
    </Border>
</UserControl>
