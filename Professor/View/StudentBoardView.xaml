<UserControl x:Class="Exam.View.StudentBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>
        <!-- 학생 수가 많아지면 스크롤이 생기도록 ScrollViewer로 감싸기 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,0,10,0">

            <!-- 리스트를 뿌려주는 ItemsControl -->
            <ItemsControl x:Name="StudentItemsControl">

                <!-- 1. 배치 방식: 무조건 4칸씩 UniformGrid -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- 2. 카드 1개의 템플릿(붕어빵 틀) 디자인 -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- 카드 전체 껍데기 (기본값: 대기 상태의 노란색 테두리) -->
                <Border x:Name="CardBorder" Background="LightYellow" BorderBrush="#FDE047" BorderThickness="2" 
                        CornerRadius="16" Margin="10" Padding="20">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 학번이 들어갈 첫 번째 줄 -->
            <RowDefinition Height="Auto"/>
            <!-- 이름과 상태가 들어갈 두 번째 줄 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 맨 위: 학번 -->
        <TextBlock Grid.Row="0" Text="{Binding StudentId}" Foreground="#94A3B8" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

        <!-- 2. 그 밑: 이름(좌) & 상태(우) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="#1E293B" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>   
            <!-- 우측: 상태 뱃지-->
            <Border x:Name="StatusBadge" BorderBrush="#F59E0B" BorderThickness="1" 
                    CornerRadius="12" Padding="10,4" Background="Transparent" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="StatusIcon" Kind="Clock" Foreground="#F59E0B" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="#F59E0B" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Border>

                        <!-- ⭐ 3. 상태에 따라 색상을 휙휙 바꾸는 마법의 DataTrigger -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="미접속">
                                <!-- 상태가 '미접속'이면 배경, 테두리, 아이콘을 회색으로 변경! -->
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#E2E8F0" />

                                <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="Transparent" />

                                <Setter TargetName="StatusText" Property="Foreground" Value="#94A3B8" />
                                <Setter TargetName="StatusIcon" Property="Kind" Value="Wifi" />
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="#94A3B8" />
                            </DataTrigger>
                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Grid>
</UserControl>