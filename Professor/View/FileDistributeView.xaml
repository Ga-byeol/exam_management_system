<UserControl x:Class="Exam.View.FileDistributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 비활성화 상태: 회색 테두리 (#E5E7EB) -->
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1.5" CornerRadius="12" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 헤더 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <DockPanel Margin="0,0,0,16">
                    <!-- 회색 '대기 중' 뱃지 -->
                    <Border DockPanel.Dock="Right" Background="#F3F4F6" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                        <TextBlock Text="대기 중" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <!-- 회색 숫자 2 -->
                    <Border Width="32" Height="32" CornerRadius="16" Background="#F3F4F6" HorizontalAlignment="Left">
                        <TextBlock Text="2" Foreground="#9CA3AF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
                <!-- 회색 제목 -->
                <TextBlock Text="시험 파일 일괄 배포" FontSize="24" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                <TextBlock Text="준비된 암호화 파일을 전체 접속 학생 PC로 동시에 전송합니다." Foreground="#9CA3AF" FontSize="15" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 2. 배포 대상 (안내 박스) -->
            <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountMultipleOutline" Foreground="#9CA3AF" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="배포 대상: 총 20명 (접속 20명 / 미접속 0명)" FontSize="16" FontWeight="Medium" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. 진행 상태 (비활성화 상태) -->
            <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="0 / 20" FontWeight="Bold" Foreground="#9CA3AF" FontSize="16"/>
                        <TextBlock Text="전송 대기 중" FontWeight="SemiBold" Foreground="#9CA3AF" FontSize="14"/>
                    </DockPanel>
                    <ProgressBar Value="0" Height="10" Foreground="#D1D5DB" Background="#E5E7EB" BorderThickness="0"/>
                    <TextBlock Text="1번 작업(암호화)을 먼저 완료해 주세요." Foreground="#9CA3AF" FontSize="13" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. 하단 안내 (버튼 대신 안내 문구) -->
            <Border Grid.Row="4" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="54">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ⓘ" Foreground="#9CA3AF" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="파일 암호화 후 활성화" Foreground="#9CA3AF" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>