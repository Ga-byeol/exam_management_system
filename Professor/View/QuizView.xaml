<UserControl x:Class="Exam.View.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#F4F4F8"
            Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,0,10,0">

            <StackPanel>

            <!-- 상단 2열 그리드 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 문제 입력 카드 -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05"
                                          BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- 카드 헤더 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <TextBlock Text="퀴즈 작성"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A1A2E"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 문제 라벨 -->
                        <TextBlock Text="문제"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,0,0,6"/>

                        <!-- 문제 입력창 -->
                        <Border Background="#F8F9FA"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12">
                            <TextBox x:Name="QuizInput"
                                     FontSize="13"
                                     Foreground="#333333"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="PlaceholderBrush"
                                                         AlignmentX="Left"
                                                         AlignmentY="Top"
                                                         Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="OX 퀴즈 문제를 입력하세요..."
                                                               FontSize="13"
                                                               Foreground="#AAAAAA"
                                                               Margin="12,10,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background"
                                                        Value="{StaticResource PlaceholderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>

                        <!-- 빠른 선택 라벨 -->
                        <TextBlock Text="빠른 선택"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,0,0,6"/>

                        <!-- 빠른 선택 태그 -->
                        <WrapPanel>
                            <Border Background="#F4F4F8" CornerRadius="20"
                                    Padding="12,6" Margin="0,0,6,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Cursor="Hand">
                                <TextBlock Text="스택(Stack)은 FIFO 구조이다..."
                                           FontSize="11" Foreground="#555555"/>
                            </Border>
                            <Border Background="#F4F4F8" CornerRadius="20"
                                    Padding="12,6" Margin="0,0,6,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Cursor="Hand">
                                <TextBlock Text="TCP는 연결 지향 프로토콜이다."
                                           FontSize="11" Foreground="#555555"/>
                            </Border>
                            <Border Background="#F4F4F8" CornerRadius="20"
                                    Padding="12,6" Margin="0,0,6,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Cursor="Hand">
                                <TextBlock Text="Python은 컴파일 언어이다."
                                           FontSize="11" Foreground="#555555"/>
                            </Border>
                            <Border Background="#F4F4F8" CornerRadius="20"
                                    Padding="12,6" Margin="0,0,6,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Cursor="Hand">
                                <TextBlock Text="이진 탐색은 정렬된 배열에서만..."
                                           FontSize="11" Foreground="#555555"/>
                            </Border>
                            <Border Background="#F4F4F8" CornerRadius="20"
                                    Padding="12,6" Margin="0,0,6,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Cursor="Hand">
                                <TextBlock Text="HTTP는 상태를 유지하는(state..."
                                           FontSize="11" Foreground="#555555"/>
                            </Border>
                        </WrapPanel>

                    </StackPanel>
                </Border>

                <!-- 오른쪽: 정답 + 전송 카드 -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05"
                                          BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- 정답 라벨 -->
                        <TextBlock Text="정답 선택"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,0,0,8"/>

                        <!-- O / X 버튼 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- O 버튼 -->
                            <Border Grid.Column="0"
                                    Background="#E8F8EE"
                                    BorderBrush="#2E7D32"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="0,16"
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="O"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="정답"
                                               FontSize="10"
                                               Foreground="#2E7D32"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- X 버튼 -->
                            <Border Grid.Column="2"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0,16"
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✕"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#E74C3C"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="오답"
                                               FontSize="10"
                                               Foreground="#888888"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 구분선 -->
                        <Separator Background="#F0F0F0" Margin="0,0,0,12"/>

                        <!-- 전송 현황 라벨 -->
                        <TextBlock Text="전송 현황"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,0,0,8"/>

                        <!-- 전송 현황 3열 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 전체 -->
                            <Border Grid.Column="0"
                                    Background="#EEEDFE"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="18"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#5B5BD6"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="전체"
                                               FontSize="10"
                                               Foreground="#888888"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 응답 -->
                            <Border Grid.Column="2"
                                    Background="#F4F4F8"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="응답"
                                               FontSize="10"
                                               Foreground="#888888"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 미응답 -->
                            <Border Grid.Column="4"
                                    Background="#F4F4F8"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="18"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="미응답"
                                               FontSize="10"
                                               Foreground="#888888"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 구분선 -->
                        <Separator Background="#F0F0F0" Margin="0,0,0,12"/>

                        <!-- 전송 버튼 -->
                        <Button x:Name="SendQuizButton"
                                Content="퀴즈 전송"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#999999"
                                Background="#F0F0F0"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0,12"
                                IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="SendBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter TargetName="SendBorder"
                                                                Property="Background"
                                                                Value="#5B5BD6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SendBorder"
                                                                Property="Background"
                                                                Value="#4A4AC4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- 하단: 실시간 응답 현황 -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05"
                                      BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>

                    <!-- 헤더 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="실시간 응답 현황"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A2E"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="#F4F4F8"
                                CornerRadius="10"
                                Padding="8,3">
                            <TextBlock Text="대기 중"
                                       FontSize="10"
                                       Foreground="#888888"/>
                        </Border>
                    </Grid>

                    <!-- O / X 응답 바 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- O 응답 -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="O (정답)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"/>
                                <TextBlock Grid.Column="1"
                                           Text="0명"
                                           FontSize="12"
                                           Foreground="#888888"/>
                            </Grid>
                            <Border Background="#F0F0F0" CornerRadius="4" Height="8">
                                <Border Background="#2E7D32"
                                        CornerRadius="4"
                                        Width="0"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>

                        <!-- X 응답 -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="✕ (오답)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#C0392B"/>
                                <TextBlock Grid.Column="1"
                                           Text="0명"
                                           FontSize="12"
                                           Foreground="#888888"/>
                            </Grid>
                            <Border Background="#F0F0F0" CornerRadius="4" Height="8">
                                <Border Background="#C0392B"
                                        CornerRadius="4"
                                        Width="0"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 안내 텍스트 -->
                    <TextBlock Text="퀴즈 전송 후 실시간으로 응답이 수집됩니다."
                               FontSize="11"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>