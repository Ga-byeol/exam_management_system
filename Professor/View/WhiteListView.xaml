<UserControl x:Class="Exam.View.WhiteListView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border Background="White"
        CornerRadius="12"
        Padding="20"
        Margin="0,0,0,12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05" 
                            BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel>

            <!-- ① 헤더 영역 -->
            <StackPanel Margin="0,0,0,12">

                <!-- 제목 -->
                <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="0,0,0,4">

                    <!-- 아이콘 (방패) -->
                    <TextBlock Text="🛡"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"/>

                    <!-- 제목 텍스트 -->
                    <TextBlock Text="허용 프로그램 (화이트리스트)"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#1A1A2E"
                            VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

            <!-- ② 태그 목록 영역 -->
            <!-- WrapPanel: 태그가 많아지면 자동으로 다음 줄로 내려감 -->
            <WrapPanel x:Name="WhitelistTagPanel"
                    Margin="0,0,0,12">

                <!-- 태그 하나 예시 (나중에 동적으로 추가됨) -->
                <Border Background="#E8F8EE"
                    CornerRadius="20"
                    Padding="10,6"
                    Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">

                        <!-- 체크 아이콘 -->
                        <TextBlock Text="✓"
                                FontSize="12"
                                Foreground="#2E7D32"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"/>

                        <!-- 프로그램 이름 -->
                        <TextBlock Text="Notepad++"
                                FontSize="12"
                                Foreground="#2E7D32"
                                VerticalAlignment="Center"/>

                        <!-- 삭제 버튼 -->
                        <Button Content="×"
                            FontSize="14"
                            Foreground="#2E7D32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#E8F8EE"
                    CornerRadius="20"
                    Padding="10,6"
                    Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓"
                                FontSize="12"
                                Foreground="#2E7D32"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="탐색기"
                                FontSize="12"
                                Foreground="#2E7D32"
                                VerticalAlignment="Center"/>
                        <Button Content="×"
                            FontSize="14"
                            Foreground="#2E7D32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ③ 입력창 + 추가 버튼 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 입력창 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 버튼 -->
                </Grid.ColumnDefinitions>

                <!-- 입력창 -->
                <Border Grid.Column="0"
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,8,0">
                    <TextBox x:Name="WhitelistInput"
                            Text=""
                            FontSize="13"
                            Foreground="#333333"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,10"
                            VerticalAlignment="Center">

                        <!-- 플레이스홀더 -->
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="PlaceholderBrush" 
                                                AlignmentX="Left"
                                                AlignmentY="Center"
                                                Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="프로그램 이름 입력 후 Enter"
                                                    FontSize="13"
                                                    Foreground="#AAAAAA"
                                                    Margin="12,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" 
                                            Value="{StaticResource PlaceholderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>

                    </TextBox>
                </Border>

                <!-- 추가 버튼 -->
                <Button Grid.Column="1"
    Content="+ 추가"
    FontSize="13"
    FontWeight="SemiBold"
    Foreground="White"
    BorderThickness="0"
    Cursor="Hand"
    Padding="20,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#1B5E20"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#145A18"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

        </StackPanel>
    </Border>
</UserControl>