<UserControl x:Class="Exam.View.EndExam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exam.View"
        mc:Ignorable="d">
    <Border Width="280" Height="360" Background="White" BorderBrush="#E5E7EB" BorderThickness="1.5" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 상단: 회색 숫자 3 & 대기 중 뱃지 -->
            <DockPanel Grid.Row="0">
                <Border DockPanel.Dock="Right" Background="#F3F4F6" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                    <TextBlock Text="대기 중" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <Border Width="32" Height="32" CornerRadius="16" Background="#F3F4F6" HorizontalAlignment="Left">
                    <TextBlock Text="3" Foreground="#9CA3AF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>

            <!-- 2. 아이콘 영역 (텍스트 '↓' 사용) -->
            <Border Grid.Row="1" Width="44" Height="44" CornerRadius="8" Background="#F9FAFB" HorizontalAlignment="Left" Margin="0,24,0,20">
                <TextBlock Text="↓" Foreground="#D1D5DB" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
            </Border>

            <!-- 3. 제목 & 설명 -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="승인 후 종료" FontSize="18" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                <TextBlock Text="실습 폴더 삭제 후 PC를 자동 종료합니다." Foreground="#9CA3AF" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>

            <!-- 4. 하단 안내 박스 (텍스트 'ⓘ' 사용) -->
            <Border Grid.Row="4" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Height="46">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ⓘ" Foreground="#9CA3AF" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="답안 수집 후 활성화" Foreground="#9CA3AF" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
