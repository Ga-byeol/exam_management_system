<Window x:Class="Exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exam"
        xmlns:views="clr-namespace:Exam.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1300" Background="#FFF5F5F3">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <views:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="15,15,15,15">
                <TextBlock Text="타이머" FontSize="26" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,20"/>
                <views:DashBoardCard/>
            </StackPanel>
            <ContentControl x:Name="MainContentArea" Grid.Row="1" Margin="10,10,10,15">
                <views:StudentBoardView/>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
